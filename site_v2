        if (pick !== null && pick >= 0 && pick < scores.length) {
          scores[pick]++;
        }
      });

      const maxScore = Math.max(...scores);
      const winners = scores.map((val, idx) => val === maxScore ? idx : -1).filter(idx => idx >= 0);

      const isMixed = winners.length > 1;
      const shareTitle = isMixed ? winners.map(w => QUIZ_CHARACTERS[w].name).join(' & ') : QUIZ_CHARACTERS[winners[0]].name;
      const shareWork = isMixed ? 'Profil mixt' : QUIZ_CHARACTERS[winners[0]].work;

      if (!isMixed) {
        const char = QUIZ_CHARACTERS[winners[0]];
