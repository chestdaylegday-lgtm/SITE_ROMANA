  <script>
    /* ========================================================================
       LOGICA ANIMAȚIEI DE DESCHIDERE A CĂRȚII PE MASĂ DE LEMN
       ======================================================================== */
    let introTimers = [];

    function runBookIntroAnimation() {
      const stage = document.getElementById('book-intro-stage');
      const book = document.getElementById('ancient-book');
      const cover = document.getElementById('book-front-cover');
      const leaf1 = document.getElementById('leaf-1');
      const leaf2 = document.getElementById('leaf-2');
      const leaf3 = document.getElementById('leaf-3');

      // Reset stare inițială
      introTimers.forEach(clearTimeout);
      introTimers = [];
      stage.classList.remove('intro-zoom-out');
      stage.style.display = 'flex';
      book.classList.remove('book-centered');
      cover.classList.remove('opened');
      leaf1.classList.remove('turned');
      leaf2.classList.remove('turned');
      leaf3.classList.remove('turned');

      // 1. Îndreaptă cartea pe masa de lemn (0.6s)
      introTimers.push(setTimeout(() => {
        book.classList.add('book-centered');
      }, 650));

      // 2. Deschide coperta groasă din piele cu scris auriu (1.4s)
      introTimers.push(setTimeout(() => {
        cover.classList.add('opened');
      }, 1450));

      // 3. Răsfoiește prima filă (2.4s)
      introTimers.push(setTimeout(() => {
        leaf1.classList.add('turned');
      }, 2400));

      // 4. Răsfoiește a doua filă (3.0s)
      introTimers.push(setTimeout(() => {
        leaf2.classList.add('turned');
      }, 3050));

      // 5. Răsfoiește a treia filă și dezvăluie citatul (3.7s)
      introTimers.push(setTimeout(() => {
        leaf3.classList.add('turned');
      }, 3700));

      // 6. Tranziție lină (zoom-in în hârtia învechită) către site (5.1s)
      introTimers.push(setTimeout(() => {
        finishBookIntro();
      }, 5150));
    }

    function finishBookIntro() {
      introTimers.forEach(clearTimeout);
      const stage = document.getElementById('book-intro-stage');
      stage.classList.add('intro-zoom-out');
      setTimeout(() => {
        stage.style.display = 'none';
      }, 950);
    }

    function replayBookIntro() {
      runBookIntroAnimation();
    }

    /* ========================================================================
       SECȚIUNEA A: DATELE EXPOZIȚIEI (AICI ÎNLOCUIȚI POZELE, POEMELE ȘI MP3-URILE)
       ======================================================================== */
    const EXHIBITS_DATA = [
