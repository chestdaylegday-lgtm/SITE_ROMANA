    function shareOnTelegram(name, work) {
      const { text, url } = getQuizShareMessage(name, work);
      const tgUrl = url
        ? `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`
        : `https://t.me/share/url?url=${encodeURIComponent('https://ro.wikipedia.org/wiki/Liviu_Rebreanu')}&text=${encodeURIComponent(text)}`;
      window.open(tgUrl, '_blank', 'noopener,noreferrer');
      setShareFeedback('tg-share-label', 'Deschis pe Telegram');
    }

    async function shareMoreApps(name, work) {
      const { text, url } = getQuizShareMessage(name, work);
      const combined = `${text}${url ? ' ' + url : ''}`;
      const shared = await tryNativeShare(`Tu ce personaj ai fi? — ${name}`, text, url);
      if (shared) {
        setShareFeedback('more-share-label', 'Distribuit');
        return;
      }
      copyTextToClipboard(combined);
      window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(combined)}`, '_blank', 'noopener,noreferrer');
      setShareFeedback('more-share-label', 'Copiat • Deschis X');
    }

