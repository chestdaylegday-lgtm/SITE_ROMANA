                    <p class="text-xs sm:text-sm leading-relaxed opacity-90 pt-1">${c.desc}</p>
                  </div>
                `;
              }).join('')}
            </div>

            <p class="text-xs opacity-60 italic pt-2">Quiz de personalitate inspirat de personaje literare — nu este un test literar.</p>
            ${renderShareButtons(shareTitle, shareWork)}
          </div>
        `;
      }
      if (window.lucide) lucide.createIcons();
    }

    function printQuizResult() {
      const box = document.getElementById('quiz-container');
      if (box) {
        box.classList.add('print-quiz-active');
        window.print();
        setTimeout(() => {
          box.classList.remove('print-quiz-active');
        }, 1000);
      }
    }

    function renderFlashcards(category) {
      const grid = document.getElementById('flashcards-grid');
      const filtered = category === 'toate' ? FLASHCARDS_DATA : FLASHCARDS_DATA.filter(f => f.cat === category);
      grid.innerHTML = filtered.map(fc => `
        <div onclick="this.querySelector('.fc-inner').classList.toggle('rotate-y-180')" class="h-72 sm:h-80 perspective-1000 cursor-pointer group">
          <div class="fc-inner relative w-full h-full transition-transform duration-500 transform-style-3d">
            <div class="absolute inset-0 backface-hidden rounded-2xl p-6 paper-card shadow-sm group-hover:border-terracotta flex flex-col justify-between border border-amber-900/15 dark:border-white/10">
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-full bg-terracotta/10 text-terracotta text-[10px] font-bold uppercase tracking-wider mb-3">
                  ${fc.tag || (fc.cat === 'ritualuri' ? 'Ritualuri de Scris' : 'Viață Personală')}
                </span>
                <h3 class="font-serif text-lg sm:text-xl font-bold leading-snug">${fc.front}</h3>
                ${fc.sub ? `<p class="text-xs sm:text-sm opacity-75 mt-2.5 italic leading-relaxed">${fc.sub}</p>` : ''}
              </div>
              <span class="text-xs opacity-60 flex items-center gap-1.5 pt-3 border-t border-amber-900/10 dark:border-white/10">
                <i data-lucide="rotate-cw" class="w-3.5 h-3.5 text-terracotta"></i>
                <span>Atinge pentru a descoperi povestea</span>
              </span>
            </div>
            <div class="absolute inset-0 backface-hidden rotate-y-180 rounded-2xl p-6 bg-terracotta text-white shadow-lg flex flex-col justify-between">
              <div class="overflow-y-auto pr-1">
                <span class="text-[10px] font-bold uppercase tracking-widest text-white/75 block mb-2">
                  ${fc.tag || 'Curiozitate Rebreanu'}
                </span>
                <p class="text-xs sm:text-sm leading-relaxed font-medium opacity-95">${fc.back}</p>
              </div>
              <span class="text-xs text-white/75 flex items-center gap-1 pt-2 border-t border-white/15 shrink-0">
                <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                <span>Atinge pentru a reveni</span>
              </span>
            </div>
          </div>
        </div>
      `).join('');
      if (window.lucide) lucide.createIcons();
    }

    const playlistAudio = document.getElementById('playlist-audio-element');
    let audioCtx = null;
    let synthTimer = null;
    let synthStep = 0;

    const MELODY_PATTERNS = {
      la_danza: {
        tempoMs: 190,
        notes: [659.25, 783.99, 880.00, 783.99, 659.25, 587.33, 659.25, 523.25, 587.33, 659.25, 783.99, 659.25]
      },
      georgia: {
        tempoMs: 360,
        notes: [261.63, 329.63, 392.00, 440.00, 392.00, 349.23, 329.63, 293.66, 261.63, 293.66, 329.63, 261.63]
      },
      ciuleandra: {
        tempoMs: 210,
        notes: [440.00, 493.88, 523.25, 659.25, 587.33, 523.25, 493.88, 440.00, 523.25, 587.33, 659.25, 523.25]
      },
      por_una_cabeza: {
        tempoMs: 240,
        notes: [440.00, 523.25, 659.25, 587.33, 523.25, 493.88, 440.00, 392.00, 440.00, 523.25, 587.33, 440.00]
      }
    };

    function ensureAudioContext() {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return null;
      if (!audioCtx) audioCtx = new Ctx();
      if (audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      return audioCtx;
    }

    function playTone(freq, durationSec) {
      const ctx = ensureAudioContext();
      if (!ctx || !freq) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, now);
      gain.gain.setValueAtTime(0.001, now);
      gain.gain.exponentialRampToValueAtTime(0.12, now + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0008, now + durationSec);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + durationSec + 0.02);
    }

    function stopSynthPlayback() {
      if (synthTimer) {
        clearInterval(synthTimer);
        synthTimer = null;
      }
    }

    function startSynthPlayback(track) {
      stopSynthPlayback();
      const pattern = MELODY_PATTERNS[track.synthKey] || MELODY_PATTERNS.la_danza;
      synthStep = 0;
      playTone(pattern.notes[synthStep % pattern.notes.length], (pattern.tempoMs / 1000) * 0.9);
      synthStep++;
      synthTimer = setInterval(() => {
        if (!isPlaylistPlaying) {
          stopSynthPlayback();
          return;
        }
        const freq = pattern.notes[synthStep % pattern.notes.length];
        playTone(freq, (pattern.tempoMs / 1000) * 0.9);
        synthStep++;
      }, pattern.tempoMs);
    }

    function renderPlaylist() {
      const list = document.getElementById('playlist-tracks');
      list.innerHTML = PLAYLIST_DATA.map((track, idx) => `
        <button onclick="playPlaylistTrack(${idx})" class="w-full py-3.5 px-3 rounded-xl hover:bg-white/10 flex items-center justify-between gap-4 text-left transition ${idx === currentPlaylistIndex && isPlaylistPlaying ? 'bg-white/15 text-gold font-semibold' : ''}">
          <div class="flex items-center gap-3.5 min-w-0">
            <span class="w-6 text-xs font-mono opacity-75">${idx + 1}</span>
            <div class="truncate">
              <p class="font-semibold text-sm truncate">${track.title}</p>
              <p class="text-xs opacity-75 truncate">${track.composer}</p>
            </div>
          </div>
          <span class="text-xs font-mono opacity-75 shrink-0">${track.duration}</span>
        </button>
      `).join('');
    }

    function playPlaylistTrack(idx) {
      currentPlaylistIndex = idx;
      const track = PLAYLIST_DATA[idx];
      stopSynthPlayback();
      playlistAudio.pause();

      if (track.src) {
        playlistAudio.src = track.src;
        playlistAudio.play().catch(() => startSynthPlayback(track));
      } else {
        startSynthPlayback(track);
      }

      isPlaylistPlaying = true;
      document.getElementById('playlist-now-playing').textContent = `Acum rulează: ${track.title} — ${track.composer}`;
      updatePlaylistMainBtn();
      renderPlaylist();
    }

    function togglePlaylistPlay() {
      const track = PLAYLIST_DATA[currentPlaylistIndex] || PLAYLIST_DATA[0];
      if (!isPlaylistPlaying) {
        playPlaylistTrack(currentPlaylistIndex);
      } else {
        isPlaylistPlaying = false;
        playlistAudio.pause();
        stopSynthPlayback();
        document.getElementById('playlist-now-playing').textContent = `Pauză: ${track.title} — ${track.composer}`;
        updatePlaylistMainBtn();
        renderPlaylist();
      }
    }

    function prevPlaylistTrack() {
      playPlaylistTrack((currentPlaylistIndex - 1 + PLAYLIST_DATA.length) % PLAYLIST_DATA.length);
    }

    function nextPlaylistTrack() {
      playPlaylistTrack((currentPlaylistIndex + 1) % PLAYLIST_DATA.length);
    }

    function updatePlaylistMainBtn() {
      document.getElementById('playlist-main-icon').setAttribute('data-lucide', isPlaylistPlaying ? 'pause' : 'play');
      lucide.createIcons();
    }

    function renderContestCodes() {
      const grid = document.getElementById('contest-codes-grid');
      grid.innerHTML = CONTEST_CODES_DATA.map(c => `
        <button onclick="openContestCode(${c.code})" class="p-4 rounded-2xl paper-card hover:border-terracotta text-left transition shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-terracotta">QR #0${c.code}</span>
          <h4 class="font-serif font-bold text-lg mt-1">${c.title}</h4>
          <p class="text-xs opacity-70 mt-2">Apasă pentru întrebarea #${c.code} →</p>
        </button>
      `).join('');
    }

    function openContestCode(codeNum) {
      const item = CONTEST_CODES_DATA.find(c => c.code === codeNum);
      if (!item) return;
      const box = document.getElementById('contest-question-box');
      box.classList.remove('hidden');
      box.innerHTML = `
        <div class="flex items-start justify-between gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-terracotta">Provocarea QR #0${item.code}</span>
            <h3 class="font-serif text-2xl font-bold mt-1">${item.question}</h3>
            <p class="text-xs opacity-75 mt-3 italic">Indiciu: ${item.hint}</p>
          </div>
          <button onclick="document.getElementById('contest-question-box').classList.add('hidden')" class="p-2 rounded-lg hover:bg-amber-900/10">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      `;
      lucide.createIcons();
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function openQrPrintModal() {
      const modal = document.getElementById('qr-print-modal');
      const area = document.getElementById('qr-print-area');
      area.innerHTML = '';
      modal.classList.remove('hidden');

      const baseUrl = `${window.location.origin}${window.location.pathname}`;

      EXHIBITS_DATA.forEach(item => {
        const card = document.createElement('div');
        card.className = 'p-4 border border-black/20 rounded-xl flex flex-col items-center text-center break-inside-avoid';
        const qrHolder = document.createElement('div');
        new QRCode(qrHolder, { text: `${baseUrl}?exponat=${item.id}`, width: 120, height: 120 });
        card.appendChild(qrHolder);
        card.innerHTML += `<p class="font-serif font-bold text-sm mt-3">Exponat #${String(item.id).padStart(2, '0')}</p><p class="text-[11px] text-black/70">${item.title}</p>`;
        area.appendChild(card);
      });

      CONTEST_CODES_DATA.forEach(c => {
        const card = document.createElement('div');
        card.className = 'p-4 border-2 border-dashed border-black/40 rounded-xl flex flex-col items-center text-center break-inside-avoid';
        const qrHolder = document.createElement('div');
        new QRCode(qrHolder, { text: `${baseUrl}?concurs=${c.code}`, width: 120, height: 120 });
        card.appendChild(qrHolder);
        card.innerHTML += `<p class="font-serif font-bold text-sm mt-3">CONCURS QR #0${c.code}</p><p class="text-[11px] text-black/70">${c.title}</p>`;
        area.appendChild(card);
      });
    }

    function closeQrPrintModal() {
      document.getElementById('qr-print-modal').classList.add('hidden');
    }

    function handleUrlParameters() {
      const params = new URLSearchParams(window.location.search);
      const expId = parseInt(params.get('exponat'), 10);
      const contestId = parseInt(params.get('concurs'), 10);

      if (expId >= 1 && expId <= EXHIBITS_DATA.length) {
        finishBookIntro();
        openExhibitModal(expId);
      } else if (contestId >= 1 && contestId <= CONTEST_CODES_DATA.length) {
        finishBookIntro();
        openContestCode(contestId);
      }
    }

    function setupEventListeners() {
      document.getElementById('exhibit-search').addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase().trim();
        const filtered = EXHIBITS_DATA.filter(item =>
          item.title.toLowerCase().includes(term) ||
          String(item.id).padStart(2, '0').includes(term) ||
          item.poem.toLowerCase().includes(term)
        );
        renderExhibits(filtered);
      });

      document.querySelectorAll('.fc-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.fc-filter-btn').forEach(b => {
            b.classList.remove('bg-terracotta', 'text-white');
            b.classList.add('paper-card');
          });
          btn.classList.add('bg-terracotta', 'text-white');
          btn.classList.remove('paper-card');
          renderFlashcards(btn.dataset.cat);
        });
      });

      const mobileMenu = document.getElementById('mobile-menu');
      document.getElementById('mobile-menu-btn').addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });

      document.getElementById('toggle-event-day').addEventListener('change', (e) => {
        const active = e.target.checked;
        document.getElementById('concurs').classList.toggle('hidden', !active);
        document.getElementById('nav-concurs-link').classList.toggle('hidden', !active);
        document.getElementById('mobile-concurs-link').classList.toggle('hidden', !active);
      });
    }
  </script>
