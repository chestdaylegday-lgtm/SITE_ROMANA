        if (window.lucide) lucide.createIcons();
        return;
      }

      if (currentQuizStep >= 0 && currentQuizStep < QUIZ_QUESTIONS.length) {
        // Ecran Întrebare
        const qObj = QUIZ_QUESTIONS[currentQuizStep];
        const pct = Math.round((currentQuizStep / QUIZ_QUESTIONS.length) * 100);
        const selPick = quizPicks[currentQuizStep] !== null ? quizPicks[currentQuizStep] : currentPick;

        box.innerHTML = `
          <div class="space-y-6">
            <div class="space-y-2">
              <div class="flex justify-between items-center text-xs font-semibold opacity-70">
                <span id="counter">Întrebarea ${currentQuizStep + 1} din ${QUIZ_QUESTIONS.length}</span>
                <span>${pct}%</span>
              </div>
              <div class="w-full h-2 rounded-full bg-amber-900/15 dark:bg-white/10 overflow-hidden">
                <div class="h-full bg-terracotta transition-all duration-300" style="width: ${pct}%"></div>
              </div>
            </div>

            <h3 class="font-serif text-xl sm:text-2xl font-bold leading-snug">${qObj.q}</h3>

            <div id="answers" class="space-y-2.5">
              ${qObj.options.map((optText, i) => {
                const isSelected = selPick === i;
                return `
                  <button type="button" onclick="selectQuizPick(${i})" ondblclick="selectAndAdvanceQuiz(${i})" class="quiz-opt-btn w-full text-left p-3.5 sm:p-4 rounded-xl border transition-all text-sm sm:text-base font-medium flex items-center justify-between cursor-pointer ${
                    isSelected
                      ? 'border-terracotta bg-terracotta/10 text-terracotta dark:text-amber-200 font-semibold shadow-sm ring-1 ring-terracotta'
                      : 'border-amber-900/20 dark:border-white/15 hover:border-terracotta hover:bg-terracotta/5'
                  }">
                    <span class="pr-3">${optText}</span>
                    <span class="w-5 h-5 rounded-full border shrink-0 flex items-center justify-center ${
                      isSelected ? 'border-terracotta bg-terracotta text-white' : 'border-amber-900/30 dark:border-white/30'
                    }">
                      ${isSelected ? '<span class="w-2 h-2 rounded-full bg-white"></span>' : ''}
                    </span>
                  </button>
                `;
              }).join('')}
            </div>

            <div class="pt-4 flex items-center justify-between gap-3 border-t border-amber-900/10 dark:border-white/10">
              ${currentQuizStep > 0
                ? `<button type="button" onclick="prevQuizQ()" class="px-4 py-2.5 rounded-xl border border-amber-900/25 dark:border-white/15 text-xs sm:text-sm font-semibold hover:border-terracotta transition flex items-center gap-1.5 cursor-pointer">
                     <i data-lucide="arrow-left" class="w-4 h-4"></i>
                     <span>Înapoi</span>
                   </button>`
                : `<div></div>`
