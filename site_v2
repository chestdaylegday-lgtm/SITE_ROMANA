<!DOCTYPE html>
<html lang="ro" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Universul Liviu Rebreanu — Expoziție Digitală Interactivă</title>

  <!-- Google Fonts: Playfair Display, Cormorant Garamond & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,500;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- QRCode.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Playfair Display"', 'Georgia', 'serif'],
            literary: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            parchment: '#D1C4B2',
            parchmentCard: '#C7B8A3',
            parchmentDeep: '#B5A38D',
            charcoal: '#8E735B',
            charcoalCard: '#B8A58C',
            terracotta: '#8E735B',
            terracottaHover: '#B8A58C',
            gold: '#B8A58C',
            goldLight: '#D1C4B2',
            woodDark: '#1C1008',
            leather: '#4A1811',
            leatherDark: '#2A0C08'
          }
        }
      }
    }
  </script>

  <style>
    /* ==========================================================================
       TEXTURĂ AUTENTICĂ DE HÂRTIE ÎNVECHITĂ (SVG NOISE + FIBRE + VIGNETTE)
       ========================================================================== */
    :root {
      --bg-primary: #D1C4B2;
      --bg-card: #C7B8A3;
      --text-primary: #241D18;
      --text-secondary: #5A4F45;
      --border-color: rgba(139, 108, 72, 0.25);
    }

    html.dark {
      --bg-primary: #8E735B;
      --bg-card: #B8A58C;
      --text-primary: #F4EFE6;
      --text-secondary: #A69F95;
      --border-color: rgba(244, 239, 230, 0.12);
    }

    body {
      background-color: var(--bg-primary);
      color: var(--text-primary);
      transition: background-color 0.45s ease, color 0.45s ease;
      overflow-x: hidden;
    }

    /* Strat permanent de textură de hârtie învechită peste tot site-ul */
    .aged-paper-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 40;
      opacity: 0.48;
      mix-blend-mode: multiply;
      background-image:
        radial-gradient(circle at 18% 22%, rgba(166, 124, 72, 0.14) 0%, transparent 45%),
        radial-gradient(circle at 82% 78%, rgba(138, 98, 52, 0.16) 0%, transparent 50%),
        radial-gradient(ellipse at center, transparent 55%, rgba(112, 78, 42, 0.18) 100%),
        url("data:image/svg+xml,%3Csvg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='paperNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='matrix' values='1 0 0 0 0  0 0.95 0 0 0  0 0 0.85 0 0  0 0 0 0.35 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23paperNoise)'/%3E%3C/svg%3E");
    }

    html.dark .aged-paper-overlay {
      opacity: 0.18;
      mix-blend-mode: screen;
    }

    /* ==========================================================================
       ANIMAȚIE INTRODUCTIVĂ 3D: CARTE VECHE PE LEMN + RĂSFOIRE FILE
       ========================================================================== */
    #book-intro-stage {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      perspective: 2200px;
      overflow: hidden;
      /* Textură bogată de masă din lemn vechi de stejar */
      background:
        radial-gradient(circle at center, rgba(62, 36, 18, 0.35) 0%, rgba(14, 7, 3, 0.92) 100%),
        repeating-linear-gradient(
          90deg,
          #26150A 0px,
          #2E1A0D 18px,
          #1F1108 36px,
          #2B180C 58px,
          #1B0E06 80px
        );
      transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Fibra lemnului generată cu SVG */
    #book-intro-stage::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0.35;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 300 300' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='woodGrain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.015 0.25' numOctaves='3' seed='8'/%3E%3CfeColorMatrix type='matrix' values='0.4 0 0 0 0.08  0 0.25 0 0 0.04  0 0 0.12 0 0.01  0 0 0 0.8 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23woodGrain)'/%3E%3C/svg%3E");
    }

    #book-intro-stage.intro-zoom-out {
      opacity: 0;
      transform: scale(1.22);
      pointer-events: none;
    }

    /* Cartea 3D */
    .ancient-book {
      position: relative;
      width: min(86vw, 390px);
      height: min(74vh, 530px);
      transform-style: preserve-3d;
      transform: rotateX(14deg) rotateY(-6deg) rotateZ(-1deg);
      transition: transform 1.2s cubic-bezier(0.25, 1, 0.35, 1);
      box-shadow:
        -22px 32px 55px rgba(0, 0, 0, 0.85),
        -6px 10px 18px rgba(0, 0, 0, 0.65);
    }

    .ancient-book.book-centered {
      transform: rotateX(4deg) rotateY(0deg) rotateZ(0deg) scale(1.04);
    }

    @media (min-width: 768px) {
      .ancient-book.book-centered {
        transform: translateX(25%) rotateX(4deg) rotateY(0deg) rotateZ(0deg) scale(1.06);
      }
    }

    /* Coperta spate + blocul gros de file */
    .book-back-board {
      position: absolute;
      inset: 0;
      border-radius: 4px 14px 14px 4px;
      background: linear-gradient(135deg, #3D120C 0%, #240905 100%);
      border: 2px solid #5C2218;
      box-shadow: inset 0 0 25px rgba(0, 0, 0, 0.8);
      transform: translateZ(-14px);
    }

    /* Muchia filelor (grosimea cărții) */
    .book-pages-block {
      position: absolute;
      top: 10px;
      bottom: 10px;
      left: 6px;
      right: 10px;
      border-radius: 2px 10px 10px 2px;
      background: #EFE4CE;
      background-image: repeating-linear-gradient(
        to bottom,
        #EFE4CE 0px,
        #E2D2B5 2px,
        #F5ECD9 4px
      );
      box-shadow:
        inset -6px 0 12px rgba(92, 64, 32, 0.35),
        inset 12px 0 22px rgba(48, 30, 14, 0.45);
      transform: translateZ(-4px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 28px 24px;
      color: #2E2218;
    }

    /* Fiecare filă care se răsfoiește */
    .flipping-leaf {
      position: absolute;
      top: 10px;
      bottom: 10px;
      left: 6px;
      right: 10px;
      transform-origin: left center;
      transform-style: preserve-3d;
      border-radius: 2px 10px 10px 2px;
      background: linear-gradient(90deg, #DFCFAE 0%, #F4EBDA 14%, #EFE3CC 88%, #DECBA8 100%);
      box-shadow:
        inset 10px 0 18px rgba(65, 42, 18, 0.25),
        0 4px 12px rgba(0, 0, 0, 0.22);
      transition: transform 1.15s cubic-bezier(0.645, 0.045, 0.355, 1);
      padding: 26px 22px;
      backface-visibility: visible;
      overflow: hidden;
    }

    .flipping-leaf.turned {
      transform: rotateY(-176deg);
    }

    /* Coperta față din piele veche + ornament auriu */
    .book-front-cover {
      position: absolute;
      inset: 0;
      transform-origin: left center;
      transform-style: preserve-3d;
      border-radius: 4px 14px 14px 4px;
      background:
        radial-gradient(circle at 30% 25%, rgba(120, 42, 28, 0.45) 0%, transparent 60%),
        linear-gradient(145deg, #541B12 0%, #370F09 55%, #230804 100%);
      border: 2px solid #6E281B;
      box-shadow:
        inset 14px 0 24px rgba(0, 0, 0, 0.65),
        inset -2px 0 6px rgba(232, 197, 101, 0.25);
      transition: transform 1.45s cubic-bezier(0.645, 0.045, 0.355, 1);
      z-index: 20;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 28px 22px;
    }

    .book-front-cover.opened {
      transform: rotateY(-178deg);
    }

    /* Cotorul cărții (nervuri în relief) */
    .book-spine-ridges {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 24px;
      background: linear-gradient(90deg, #1E0704 0%, #4A1810 50%, #240905 100%);
      border-right: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: 4px 0 0 4px;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      padding: 24px 0;
    }

    .book-spine-ridges span {
      display: block;
      height: 5px;
      width: 100%;
      background: linear-gradient(to bottom, rgba(232,197,101,0.35), rgba(0,0,0,0.6));
      box-shadow: 0 2px 3px rgba(0,0,0,0.7);
    }

    /* Chenar auriu embosat pe copertă */
    .gold-emboss-frame {
      position: relative;
      width: calc(100% - 18px);
      height: 100%;
      margin-left: 16px;
      border: 1.5px solid rgba(218, 178, 76, 0.65);
      outline: 1px solid rgba(218, 178, 76, 0.28);
      outline-offset: -6px;
      border-radius: 2px 8px 8px 2px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 28px 16px;
      text-align: center;
    }

    .gold-foil-text {
      background: linear-gradient(180deg, #F7E199 0%, #D4A438 48%, #9C721C 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.85));
    }

    /* ==========================================================================
       RESTUL STILURILOR SITE-ULUI (FLASHCARD 3D, PLAYER AUDIO, ETC.)
       ========================================================================== */
    .perspective-1000 { perspective: 1000px; }
    .transform-style-3d { transform-style: preserve-3d; }
    .backface-hidden { backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }

    @keyframes eqBar {
      0%, 100% { height: 22%; }
      50% { height: 95%; }
    }
    .eq-playing .eq-bar-1 { animation: eqBar 0.75s ease-in-out infinite; }
    .eq-playing .eq-bar-2 { animation: eqBar 0.55s ease-in-out infinite 0.15s; }
    .eq-playing .eq-bar-3 { animation: eqBar 0.85s ease-in-out infinite 0.3s; }
    .eq-playing .eq-bar-4 { animation: eqBar 0.65s ease-in-out infinite 0.1s; }

    /* Stil subtil de margine de hârtie pentru carduri */
    .paper-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      box-shadow: 0 6px 24px -8px rgba(68, 46, 22, 0.14);
    }

    @media print {
      body * { visibility: hidden; }
      #qr-print-area, #qr-print-area *,
      .print-quiz-active, .print-quiz-active * { visibility: visible; }
      #qr-print-area, .print-quiz-active {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        background: white !important;
        color: black !important;
        padding: 24px;
      }
      .print-quiz-active button { display: none !important; }
    }
  </style>
</head>
