              </button>
            </div>
          </div>
        `;
        if (window.lucide) lucide.createIcons();
        return;
      }

      // Ecran Rezultat
      showQuizResult(box);
    }

    function startQuiz() {
      currentQuizStep = 0;
      quizPicks = Array(QUIZ_QUESTIONS.length).fill(null);
      currentPick = null;
      renderQuiz();
    }

    function selectQuizPick(idx) {
      currentPick = idx;
      quizPicks[currentQuizStep] = idx;
      const nextBtn = document.getElementById('quiz-next-btn');
      if (nextBtn) nextBtn.disabled = false;

      const optButtons = document.querySelectorAll('.quiz-opt-btn');
      optButtons.forEach((btn, i) => {
        const isSelected = i === idx;
        if (isSelected) {
          btn.className = 'quiz-opt-btn w-full text-left p-3.5 sm:p-4 rounded-xl border transition-all text-sm sm:text-base font-semibold flex items-center justify-between cursor-pointer border-terracotta bg-terracotta/10 text-terracotta dark:text-amber-200 shadow-sm ring-1 ring-terracotta';
          const indicator = btn.querySelector('span:last-child');
          if (indicator) {
            indicator.className = 'w-5 h-5 rounded-full border shrink-0 flex items-center justify-center border-terracotta bg-terracotta text-white';
            indicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-white"></span>';
          }
        } else {
          btn.className = 'quiz-opt-btn w-full text-left p-3.5 sm:p-4 rounded-xl border transition-all text-sm sm:text-base font-medium flex items-center justify-between cursor-pointer border-amber-900/20 dark:border-white/15 hover:border-terracotta hover:bg-terracotta/5';
          const indicator = btn.querySelector('span:last-child');
          if (indicator) {
            indicator.className = 'w-5 h-5 rounded-full border shrink-0 flex items-center justify-center border-amber-900/30 dark:border-white/30';
            indicator.innerHTML = '';
          }
        }
      });
    }

    function selectAndAdvanceQuiz(idx) {
      selectQuizPick(idx);
      nextQuizQ();
    }

    function nextQuizQ() {
      const sel = quizPicks[currentQuizStep] !== null ? quizPicks[currentQuizStep] : currentPick;
      if (sel === null) return;
      quizPicks[currentQuizStep] = sel;
      currentQuizStep++;
      currentPick = currentQuizStep < QUIZ_QUESTIONS.length ? quizPicks[currentQuizStep] : null;
      renderQuiz();
    }

    function prevQuizQ() {
      if (currentQuizStep > 0) {
        currentQuizStep--;
        currentPick = quizPicks[currentQuizStep];
        renderQuiz();
      }
    }

    function restartQuiz() {
      currentQuizStep = 0;
      quizPicks = Array(QUIZ_QUESTIONS.length).fill(null);
      currentPick = null;
      renderQuiz();
    }

    function resetQuiz() {
      restartQuiz();
    }

    function answerQuiz(charKey) {
      // Compatibilitate dacă este apelat dintr-un handler vechi
      if (typeof charKey === 'number') {
        selectAndAdvanceQuiz(charKey);
      }
    }

    /* ========================================================================
       SHARE CU ICONIȚE, WHATSAPP STARE, INSTAGRAM STARE, FACEBOOK & SOCIAL MEDIA
       ======================================================================== */
    function escapeAttr(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/'/g, "&#39;")
        .replace(/"/g, "&quot;");
    }

    function getPublicShareUrl(hash = '#quiz-personaj') {
      try {
        if (window.location.protocol === 'http:' || window.location.protocol === 'https:') {
          return `${window.location.origin}${window.location.pathname}${hash}`;
        }
      } catch (_) {}
      return '';
    }

    function getQuizShareMessage(name, work) {
      const url = getPublicShareUrl('#quiz-personaj');
      const text = `În quiz-ul „Tu ce personaj ai fi? — Liviu Rebreanu”, am primit: ${name} (${work}).`;
      return { text, url };
    }

    function copyTextToClipboard(text) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).catch(() => {});
      } else {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (_) {}
        document.body.removeChild(ta);
      }
    }

    async function tryNativeShare(title, text, url) {
      if (!navigator.share || !window.isSecureContext) return false;
      const payload = { title, text };
      if (url && /^https?:\/\//i.test(url)) {
        payload.url = url;
      }
      try {
        if (navigator.canShare && !navigator.canShare(payload)) return false;
        await navigator.share(payload);
        return true;
      } catch (err) {
        if (err && err.name === 'AbortError') return true;
        return false;
      }
    }

    function setShareFeedback(id, msg, duration = 3000) {
      const el = document.getElementById(id);
      if (!el) return;
      const prev = el.dataset.origLabel || el.textContent;
      if (!el.dataset.origLabel) el.dataset.origLabel = prev;
      el.textContent = msg;
      clearTimeout(el._fbTimer);
      el._fbTimer = setTimeout(() => {
        el.textContent = el.dataset.origLabel;
      }, duration);
    }

    function shareOnWhatsAppChat(name, work) {
      const { text, url } = getQuizShareMessage(name, work);
      const combined = `${text}${url ? ' ' + url : ''}`;
      copyTextToClipboard(combined);
      window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(combined)}`, '_blank', 'noopener,noreferrer');
      setShareFeedback('wa-chat-label', 'Deschis pe WhatsApp');
    }

