    function openExhibitModal(id) {
      const idx = EXHIBITS_DATA.findIndex(e => e.id === id);
      if (idx === -1) return;
      currentExhibitIndex = idx;
      const item = EXHIBITS_DATA[idx];

      document.getElementById('modal-badge').textContent = `Exponat #${String(item.id).padStart(2, '0')}`;
      document.getElementById('modal-title').textContent = item.title;
      document.getElementById('modal-img').src = item.image;
      document.getElementById('modal-img').alt = item.title;
      document.getElementById('modal-poem').textContent = item.poem;

      exhibitAudio.pause();
      exhibitAudio.src = item.audio;
      modalProgress.value = 0;
      document.getElementById('modal-time-current').textContent = '0:00';
      updateModalPlayUI(false);

      document.getElementById('exhibit-modal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeExhibitModal() {
      exhibitAudio.pause();
      updateModalPlayUI(false);
      document.getElementById('exhibit-modal').classList.add('hidden');
      document.body.style.overflow = '';
    }

    function navigateExhibit(dir) {
      const next = (currentExhibitIndex + dir + EXHIBITS_DATA.length) % EXHIBITS_DATA.length;
      openExhibitModal(EXHIBITS_DATA[next].id);
    }

    function toggleExhibitAudio() {
      if (exhibitAudio.paused) {
        exhibitAudio.play();
        updateModalPlayUI(true);
      } else {
        exhibitAudio.pause();
        updateModalPlayUI(false);
      }
    }

    function updateModalPlayUI(playing) {
      const icon = document.getElementById('modal-play-icon');
      const eq = document.getElementById('modal-eq');
      icon.setAttribute('data-lucide', playing ? 'pause' : 'play');
      eq.classList.toggle('eq-playing', playing);
      lucide.createIcons();
    }

    exhibitAudio.addEventListener('timeupdate', () => {
      if (!exhibitAudio.duration) return;
      modalProgress.value = (exhibitAudio.currentTime / exhibitAudio.duration) * 100;
      document.getElementById('modal-time-current').textContent = formatTime(exhibitAudio.currentTime);
      document.getElementById('modal-time-duration').textContent = formatTime(exhibitAudio.duration);
    });

    exhibitAudio.addEventListener('ended', () => updateModalPlayUI(false));

    modalProgress.addEventListener('input', () => {
      if (exhibitAudio.duration) {
        exhibitAudio.currentTime = (modalProgress.value / 100) * exhibitAudio.duration;
      }
    });

